{
  "manifest_version": 3,
  "name": "Incogprio",
  "version": "1.0",
  "description": "Mask your student number and priority in CRS :)",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://crs.upd.edu.ph/*"
      ],
      "js": ["content.js"]
    }
  ]
}
